---
import BaseLayout from '../layouts/BaseLayout.astro';
import { projects } from '../data/projects';
---
<BaseLayout pageTitle="projects — blake martinez" description="Blake Martinez's side projects">
  <h2 class="section-label">projects</h2>
  <ul class="project-grid">
    {projects.map((project) => (
      <li class="project-card">
        {project.screenshot && (
          <div class={`project-preview ${project.browserFrame ? 'browser-frame' : 'plain-frame'}`}>
            {project.browserFrame && (
              <div class="browser-chrome">
                <span class="chrome-dot"></span>
                <span class="chrome-dot"></span>
                <span class="chrome-dot"></span>
                <span class="chrome-url">{project.url ?? project.githubUrl ?? ''}</span>
              </div>
            )}
            <img
              src={project.screenshot}
              alt={`${project.name} screenshot`}
              loading="lazy"
            />
          </div>
        )}
        <div class="project-body">
          <div class="project-info">
            <p class="project-name">
              {project.name}
              {project.favorite && <span class="fav-star" title="current passion project">★</span>}
            </p>
            <p class="project-desc">
            {project.desc}
            {project.note && (
              <> — <a href={project.note.url} target="_blank" rel="noopener">{project.note.text} ↗</a></>
            )}
          </p>
            <div class="stack-badges">
              {project.stack.map((tech) => (
                <span class="badge">{tech}</span>
              ))}
            </div>
          </div>
          <div class="project-links">
            {project.url && (
              <a class="project-link" href={project.url} target="_blank" rel="noopener">live ↗</a>
            )}
            {project.githubUrl && (
              <a class="project-link" href={project.githubUrl} target="_blank" rel="noopener">github ↗</a>
            )}
            {!project.url && !project.githubUrl && (
              <span class="project-link" style="color: var(--text-muted);">wip</span>
            )}
          </div>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
