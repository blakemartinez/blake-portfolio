---
import BaseLayout from '../layouts/BaseLayout.astro';
import SubstackFeed from '../components/SubstackFeed.astro';
import { SUBSTACK_URL } from '../consts';
---
<BaseLayout title="writing — blake martinez" description="Blake Martinez's writing on software, keyboards, and more.">
  <h1 class="section-label">writing</h1>
  <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: var(--space-md);">
    Published on <a href={SUBSTACK_URL} target="_blank" rel="noopener">Substack ↗</a>
  </p>
  <SubstackFeed />
</BaseLayout>
