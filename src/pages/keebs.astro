---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="keebs — blake martinez" description="Blake's mechanical keyboard collection.">
  <h1 class="section-label">keebs</h1>
  <div class="keebs-container">
    <model-viewer
      src="/keebRender.gltf"
      ar
      ar-modes="webxr scene-viewer quick-look"
      camera-controls
      poster="/poster.webp"
      camera-orbit="-90.41deg 61.51deg 0.8191m"
      field-of-view="30deg"
      shadow-intensity="1"
      auto-rotate
    ></model-viewer>
  </div>
  <script type="module" src="https://ajax.googleapis.com/ajax/libs/model-viewer/3.1.1/model-viewer.min.js"></script>
</BaseLayout>
