---
const interests = [
  "riftbound", "vinyl record collecting", "baseball", "pickleball",
  "weightlifting", "building pc's", "music festivals", "mechanical keyboards", "more...",
];
---
<div class="marquee-wrap marquee-last">
  <span class="marquee-label marquee-label-left">enjoying →</span>
  <div class="marquee-track">
    {[...interests, ...interests].map((item) => (
      <span class="marquee-item">{item}<span class="marquee-sep">✦</span></span>
    ))}
  </div>
</div>
