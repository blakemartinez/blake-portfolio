---
const tech = [
  "python", "java", "typescript", "javascript", "scala", "sql",
  "astro", "react", "d3.js", "node.js", "django", "flask",
  "claude", "ai agents", "llms",
];

const interests = [
  "mechanical keyboards", "vinyl records", "pokémon", "pinterest",
  "discogs", "baseball", "music festivals",
];
---

<div class="marquee-wrap">
  <div class="marquee-track">
    {[...tech, ...tech].map((item) => (
      <span class="marquee-item">{item}<span class="marquee-sep">✦</span></span>
    ))}
  </div>
</div>

<div class="marquee-wrap marquee-reverse">
  <div class="marquee-track">
    {[...interests, ...interests].map((item) => (
      <span class="marquee-item">{item}<span class="marquee-sep">✦</span></span>
    ))}
  </div>
</div>
